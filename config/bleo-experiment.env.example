# OpenMC SoftwareX experimental control profile.
# Copy to config/bleo-experiment.env and edit for the actual bLEO topology.
#
# bLEO uses eBPF maps updated by /usr/local/bin/updatemap.  OpenMC does not
# guess which bLEO interfaces form Path A or Path B; list every interface that
# must receive the configured one-way path delay as NAMESPACE:INTERFACE.
# Multiple targets are comma-separated.

BLEO_VERSION=unknown
BLEO_COMMIT=unknown
BLEO_UPDATEMAP=/usr/local/bin/updatemap
BLEO_PRIVILEGE_COMMAND=sudo

# EXAMPLES ONLY -- replace with the exact targets of the deployed bLEO scenario.
BLEO_PATH_A_DELAY_TARGETS=
BLEO_PATH_B_DELAY_TARGETS=

# Address of the final OpenMC application destination from the Source Host.
DESTINATION_ADDRESS=10.102.96.2

# Optional provenance overrides. BLEO_REPO defaults to the parent of openmc-main.
# If OpenMC is deployed from a ZIP without .git metadata, set OPENMC_COMMIT to
# the exact GitHub commit used to create the archive.
BLEO_REPO=..
OPENMC_COMMIT=
